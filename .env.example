# On the live server set NODE_ENV=production (secure login cookies; the site must be on https)
PORT=3000
NODE_ENV=development

# Public address of the site, used in links inside emails (no trailing slash)
SITE_URL=https://horizoncollegelondon.com
SITE_NAME=Horizon College London
SESSION_SECRET=replace-with-a-long-random-string

# First admin account (only used by `npm run seed`, on an empty database)
ADMIN_EMAIL=admin@horizoncollegelondon.com
ADMIN_PASSWORD=ChangeMe123!

# Where enrolment and contact notifications go
NOTIFY_EMAIL=info@horizoncollegelondon.com

# Email is sent through Resend (resend.com): verify horizoncollegelondon.com there, then create an API key.
# Without a key, emails are written to the log instead of sent.
RESEND_API_KEY=
MAIL_FROM=Horizon College London <noreply@horizoncollegelondon.com>
# Where learners' replies go (enquiry notifications reply to the person who wrote in instead)
REPLY_TO=info@horizoncollegelondon.com

# Supabase: server-side only, never put these in browser code
# Supabase -> Connect -> Transaction pooler connection string (port 6543), with the database password filled in
DATABASE_URL=
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database connections kept open by the app: 10 suits a VPS (the default, 3, suits Vercel's many small instances)
# DB_POOL_MAX=10

# Optional upload limits in MB. Supabase Free caps every file at 50 MB; on Pro raise these, then run `npm run setup-storage`
# MAX_VIDEO_MB=50
# MAX_FILE_MB=50
# MAX_SCORM_MB=500

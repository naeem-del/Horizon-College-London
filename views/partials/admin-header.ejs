<%- include('head') %>
<body class="admin">
<div class="admin-shell">
  <aside class="admin-side" id="side">
    <button class="admin-burger" onclick="document.getElementById('side').classList.toggle('open')">Menu</button>
    <a class="brand" href="/admin"><%- include('mark') %><span class="brand-name">Horizon<small>Admin</small></span></a>
    <nav>
      <% const isAdmin = user.role === 'admin'; const on = p => (p === '/admin' ? path === '/admin' : path.startsWith(p)) ? 'on' : ''; %>
      <a class="<%= on('/admin') %>" href="/admin">Dashboard</a>
      <div class="group">Teaching</div>
      <a class="<%= on('/admin/submissions') %>" href="/admin/submissions">Evidence review <% if (badges.submissions) { %><span class="count"><%= badges.submissions %></span><% } %></a>
      <% const sec = typeof section !== 'undefined' ? section : (path.startsWith('/admin/staff') ? 'staff' : path.startsWith('/admin/students') ? 'learners' : ''); %>
      <a class="<%= sec === 'learners' ? 'on' : '' %>" href="/admin/students">Learners</a>
      <a class="<%= sec === 'staff' ? 'on' : '' %>" href="/admin/staff">Staff</a>
      <% if (!isAdmin) { %><a class="<%= sec === 'courses' || path.startsWith('/admin/courses') ? 'on' : '' %>" href="/admin/courses">My courses</a><% } %>
      <% if (isAdmin) { %>
        <a class="<%= on('/admin/enrolments') %>" href="/admin/enrolments">Enrolments <% if (badges.enrolments) { %><span class="count"><%= badges.enrolments %></span><% } %></a>
        <a class="<%= on('/admin/enquiries') %>" href="/admin/enquiries">Enquiries <% if (badges.enquiries) { %><span class="count"><%= badges.enquiries %></span><% } %></a>
        <div class="group">Catalogue</div>
        <a class="<%= sec === 'courses' || path.startsWith('/admin/courses') ? 'on' : '' %>" href="/admin/courses">Courses</a>
        <a class="<%= on('/admin/bodies') %>" href="/admin/bodies">Awarding bodies</a>
      <% } %>
      <div class="group">Site</div>
      <a class="<%= sec === 'policies' ? 'on' : '' %>" href="/admin/policies">Policies</a>
      <a class="<%= sec === 'account' ? 'on' : '' %>" href="/admin/account">My account</a>
      <a href="/" target="_blank">View website</a>
    </nav>
    <div class="me"><span class="person"><%- include('avatar', { who: user }) %><%= user.name %></span>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-btn">Log out</button></form>
    </div>
  </aside>
  <main class="admin-main" id="main">
  <% if (flash) { %><div class="flash" style="margin:0 0 20px;padding:0;max-width:none" role="status"><div class="<%= flash.type %>"><%= flash.text %></div></div><% } %>

<a class="course-card" href="/courses/<%= c.slug %>">
  <div class="course-top">
    <% if (c.image) { %><img src="<%= fileUrl('images', c.image) %>" alt="" loading="lazy"><% } else { %><span class="arc"></span><% } %>
    <% if (c.level) { %><span class="level-tag"><%= c.level %></span><% } %>
  </div>
  <div class="course-body">
    <h3><%= c.title %></h3>
    <p><%= c.summary %></p>
    <div class="course-meta">
      <% if (c.body_name) { %><span>Awarded by <strong><%= c.body_name %></strong></span><% } %>
      <% if (c.duration) { %><span><%= c.duration %></span><% } %>
      <% if (c.study_mode) { %><span><%= c.study_mode %></span><% } %>
    </div>
  </div>
</a>

<%- include('../partials/header') %>
<div class="auth">
  <div class="auth-art"><h2>Welcome to Horizon.</h2><p>Choose a password to finish setting up your account.</p></div>
  <div class="auth-form">
    <% if (who) { %>
    <form method="post" action="/set-password/<%= token %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h1 style="font-size:2.2rem">Choose a password</h1>
      <p class="muted">For <strong><%= who.email %></strong></p>
      <% if (errors.length) { %><div class="errors" role="alert"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
      <label class="field"><span>New password</span><input type="password" name="password" autocomplete="new-password" minlength="8" required autofocus><small>At least 8 characters.</small></label>
      <label class="field"><span>Confirm password</span><input type="password" name="password2" autocomplete="new-password" required></label>
      <button class="btn btn-navy" style="width:100%;justify-content:center">Save password and log in</button>
    </form>
    <% } else { %>
    <div style="max-width:400px">
      <h1 style="font-size:2.2rem">Link expired</h1>
      <p class="muted">This link has expired or has already been used. Request a new one below, or ask the college to send you a fresh invitation.</p>
      <a class="btn btn-navy" href="/forgot-password">Request a new link</a>
    </div>
    <% } %>
  </div>
</div>
</main></body></html>

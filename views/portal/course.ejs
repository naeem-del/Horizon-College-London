<%- include('../partials/header') %>
<%- include('../partials/portal-nav') %>
<div class="portal-main"><div class="wrap player">
  <%- include('_nav') %>
  <div class="lesson">
    <p class="muted" style="margin:0"><%= [course.level, course.body_name].filter(Boolean).join(', ') %></p>
    <h1 style="font-size:2.3rem"><%= course.title %></h1>
    <div class="bar" style="max-width:none"><i style="width:<%= prog.pct %>%"></i></div>
    <p class="muted small"><%= prog.done %> of <%= prog.total %> lessons and evidence tasks complete</p>
    <div class="lesson-body"><%- paras(course.summary) %></div>
    <% if (nextLesson) { %>
      <a class="btn btn-gold" href="/portal/courses/<%= course.slug %>/lessons/<%= nextLesson.id %>"><%= prog.done ? 'Continue: ' : 'Start: ' %><%= nextLesson.title %></a>
    <% } else { %>
      <p class="muted">Your tutor is still adding content to this course. Check back soon.</p>
    <% } %>
  </div>
</div></div>
<%- include('../partials/footer') %>

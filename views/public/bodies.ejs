<%- include('../partials/header') %>
<section class="page-head"><div class="wrap">
  <h1>Awarding bodies</h1>
  <p>We’re an approved centre for the organisations below. They set the standards, quality-assure our assessment and issue your certificate.</p>
</div></section>
<section class="section" style="padding-top:44px"><div class="wrap">
  <% if (!bodies.length) { %><p class="muted">No awarding bodies added yet.</p><% } %>
  <div class="grid">
    <% bodies.forEach(b => { %>
      <a class="course-card" href="/awarding-bodies/<%= b.slug %>">
        <div class="course-body">
          <div style="display:flex;gap:14px;align-items:center;margin-bottom:14px">
            <% if (b.logo) { %><img src="/uploads/images/<%= b.logo %>" alt="" style="height:48px;width:auto"><% } else { %><span class="body-mono" style="width:48px;height:48px;font-size:1rem"><%= initials(b.name) %></span><% } %>
            <h3 style="margin:0"><%= b.name %></h3>
          </div>
          <p><%= (b.description || '').slice(0, 180) %><%= (b.description || '').length > 180 ? '…' : '' %></p>
          <div class="course-meta"><span><strong><%= b.course_count %></strong> <%= b.course_count === 1 ? 'course' : 'courses' %></span></div>
        </div>
      </a>
    <% }) %>
  </div>
</div></section>
<%- include('../partials/footer') %>
